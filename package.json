{
  "name": "langecs-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:packaging": "node scripts/check-packaging.mjs",
    "version:all": "node scripts/version-all.mjs",
    "publish:dry": "pnpm -r --filter \"./packages/*\" publish --dry-run --access public --no-git-checks",
    "publish:packages": "pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
