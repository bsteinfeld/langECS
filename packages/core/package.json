{
  "name": "@langecs/core",
  "version": "0.1.0",
  "description": "Entity-Component-System runtime for LLM agents and multi-agent systems",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsteinfeld/langECS.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/bsteinfeld/langECS/issues",
  "homepage": "https://github.com/bsteinfeld/langECS/tree/main/packages/core#readme",
  "keywords": [
    "llm",
    "agents",
    "ai",
    "agent-framework",
    "ecs",
    "entity-component-system",
    "typescript",
    "runtime",
    "scheduler",
    "state-management",
    "multi-agent"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
