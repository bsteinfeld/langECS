{
  "name": "@langecs/stdlib",
  "version": "0.2.0",
  "description": "Standard components, systems, and agent presets for LangECS (Inbox, retry, ReAct, human-in-the-loop)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsteinfeld/langECS.git",
    "directory": "packages/stdlib"
  },
  "bugs": "https://github.com/bsteinfeld/langECS/issues",
  "homepage": "https://github.com/bsteinfeld/langECS/tree/main/packages/stdlib#readme",
  "keywords": [
    "llm",
    "agents",
    "ai",
    "agent-framework",
    "ecs",
    "entity-component-system",
    "typescript",
    "react-agent",
    "tools",
    "structured-output",
    "routing"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@langecs/core": "workspace:^"
  },
  "devDependencies": {
    "@langecs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
