{
  "name": "@langecs/ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK model adapter for LangECS — every provider via one dependency",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsteinfeld/langECS.git",
    "directory": "packages/ai-sdk"
  },
  "bugs": "https://github.com/bsteinfeld/langECS/issues",
  "homepage": "https://github.com/bsteinfeld/langECS/tree/main/packages/ai-sdk#readme",
  "keywords": [
    "llm",
    "agents",
    "ai",
    "agent-framework",
    "ecs",
    "entity-component-system",
    "typescript",
    "vercel-ai-sdk",
    "model-adapter",
    "streaming"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langecs/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=5"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "ai": "^6.0.199"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
