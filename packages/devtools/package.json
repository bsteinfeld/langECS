{
  "name": "@langecs/devtools",
  "version": "0.1.0",
  "description": "Visual inspector for LangECS worlds — live entity/component state, interactive mutation, flight-recorder timeline, OTLP trace waterfall, human-in-the-loop",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langecs/langecs.git",
    "directory": "packages/devtools"
  },
  "bugs": "https://github.com/langecs/langecs/issues",
  "homepage": "https://github.com/langecs/langecs/tree/main/packages/devtools#readme",
  "keywords": [
    "llm",
    "agents",
    "ai",
    "agent-framework",
    "ecs",
    "entity-component-system",
    "typescript",
    "devtools",
    "inspector",
    "debugging",
    "observability"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && vite build",
    "dev:ui": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit"
  },
  "dependencies": {
    "@langecs/core": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
